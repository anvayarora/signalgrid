# Safe local defaults. This file intentionally contains no API keys.
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/signalgrid.db
DATASET_PATH=./data/raw/monitoring.csv

# Isolated demo mode enables admin/admin123, user/user123, and analyst/analyst123.
SIGNALGRID_DEMO_AUTH=true
# For non-demo authentication, replace these placeholders in a private file.
SIGNALGRID_ADMIN_PASSWORD=change-me
SIGNALGRID_VIEWER_PASSWORD=change-me
SIGNALGRID_ANALYST_PASSWORD=change-me
AUTH_TOKEN_TTL_MS=3600000
SSE_TICKET_TTL_MS=60000
SSE_HEARTBEAT_MS=5000

# Deterministic RCA is the safe default. Hosted inference is always explicit.
RCA_PROVIDER=deterministic
RCA_MAX_HOSTED_ANALYSES=5
RCA_MAX_CONCURRENCY=1
RCA_MAX_TOOL_ROUNDS=3
RCA_MAX_TOOL_EXECUTIONS=5
RCA_REQUEST_TIMEOUT_MS=45000
RCA_TOTAL_TIMEOUT_MS=150000
RCA_MAX_RETRIES=1
RCA_RETRY_BACKOFF_MS=150
RCA_NVIDIA_FINAL_JSON_RETRY=true

# Replay defaults.
REPLAY_CURATED_CADENCE_MS=1500
REPLAY_MAX_CONCURRENT=3

# Optional local Ollama provider settings.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b

# Optional NVIDIA Build settings. Leave NVIDIA_KEY empty unless you add a key
# to a private environment file outside source control.
NVIDIA_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
